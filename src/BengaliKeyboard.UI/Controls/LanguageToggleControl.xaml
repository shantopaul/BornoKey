<UserControl x:Class="BengaliKeyboard.UI.Controls.LanguageToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Key.Regular.Background}"
            BorderBrush="{DynamicResource Brush.Window.Border}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="2"
            Cursor="Hand"
            ToolTip="Click to toggle Bangla / English (Ctrl+Space)"
            PreviewMouseLeftButtonDown="OnToggleMouseLeftButtonDown">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="BanglaPillBorder"
                    Background="{DynamicResource Brush.Accent.Primary}"
                    CornerRadius="4"
                    Padding="7,1">
                <TextBlock Text="বাংলা"
                           FontFamily="{StaticResource FontFamily.Bengali}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center" />
            </Border>
            <Border x:Name="EnglishPillBorder"
                    Background="Transparent"
                    CornerRadius="4"
                    Padding="7,1">
                <TextBlock Text="ENG"
                           FontFamily="{StaticResource FontFamily.English}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           VerticalAlignment="Center" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
