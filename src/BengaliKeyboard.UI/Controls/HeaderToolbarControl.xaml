<UserControl x:Class="BengaliKeyboard.UI.Controls.HeaderToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BengaliKeyboard.UI.Controls"
             Focusable="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/KeyStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Header.Background}"
            BorderBrush="{DynamicResource Brush.Window.Border}"
            BorderThickness="0,0,0,1"
            Padding="10,0,6,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand & Drag Handle -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <TextBlock Text="≡"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="15"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="BornoKey"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontFamily="{StaticResource FontFamily.English}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- [ বাংলা | ENG ] Pill Switch -->
            <controls:LanguageToggleControl x:Name="LanguageToggle"
                                            Grid.Column="1"
                                            VerticalAlignment="Center" />

            <!-- Right Window & 4-Mode Action Controls -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="CompactModeButton"
                        Content="Compact"
                        Style="{StaticResource Style.Button.HeaderAction}"
                        ToolTip="Toggle Compact / Expanded Mode"
                        Click="OnCompactClick" />
                <Button x:Name="MinimalIconButton"
                        Content="বাংলা"
                        Style="{StaticResource Style.Button.HeaderAction}"
                        ToolTip="Shrink to Minimal Floating [বাংলা] Icon"
                        Click="OnMinimalIconClick" />
                <Button x:Name="MinimizeButton"
                        Content="—"
                        Width="26"
                        Style="{StaticResource Style.Button.HeaderAction}"
                        ToolTip="Hide Keyboard to System Tray"
                        Click="OnMinimizeClick" />
                <Button x:Name="CloseButton"
                        Content="✕"
                        Width="26"
                        Style="{StaticResource Style.Button.HeaderAction}"
                        ToolTip="Close BornoKey"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
