<Window x:Class="BengaliKeyboard.UI.Windows.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BornoKey — Clipboard History"
        Width="850"
        Height="310"
        MinWidth="440"
        MinHeight="180"
        MaxWidth="1600"
        MaxHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/KeyStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Window.Background}"
            BorderBrush="{DynamicResource Brush.Window.Border}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header Bar with Search, Pause/Resume Monitoring, Clear Unpinned, and Back -->
                <RowDefinition Height="38" />
                <!-- Row 1: Scrollable Clipboard Entries List -->
                <RowDefinition Height="*" />
                <!-- Row 2: Privacy Status Footer -->
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back to Keyboard Button -->
                    <Button Grid.Column="0"
                            Content="← বাংলা / ABC"
                            Command="{Binding BackToKeyboardCommand}"
                            Click="OnNonSearchActionClick"
                            Background="{DynamicResource Brush.Key.Special.Background}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            BorderThickness="0"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            ToolTip="Return to Virtual Keyboard" />

                    <!-- Real-Time Search Box -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource Brush.Key.Regular.Background}"
                            BorderBrush="{DynamicResource Brush.Window.Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2">
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     CaretBrush="{DynamicResource Brush.Accent.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.5"
                                     PreviewMouseLeftButtonDown="OnSearchBoxPreviewMouseLeftButtonDown"
                                     LostFocus="OnSearchBoxLostFocus" />
                            <TextBlock Text="Search clipboard history (বাংলা / English)..."
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Pause / Resume Monitoring Toggle Button -->
                    <Button Grid.Column="2"
                            Command="{Binding ToggleMonitoringCommand}"
                            Click="OnNonSearchActionClick"
                            Background="{DynamicResource Brush.Key.Special.Background}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            BorderThickness="0"
                            Padding="8,4"
                            Margin="8,0,0,0"
                            FontSize="11.5"
                            Cursor="Hand"
                            ToolTip="Pause or Resume Clipboard Monitoring">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Pause Capture" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoringEnabled}" Value="False">
                                        <Setter Property="Content" Value="Resume Capture" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Clear Unpinned Clips Button -->
                    <Button Grid.Column="3"
                            Content="Clear Unpinned"
                            Command="{Binding ClearUnpinnedCommand}"
                            Click="OnNonSearchActionClick"
                            Background="{DynamicResource Brush.Key.Special.Background}"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8,4"
                            Margin="6,0,0,0"
                            FontSize="11.5"
                            Cursor="Hand"
                            ToolTip="Delete all unpinned clipboard items (pinned items are kept)" />

                    <!-- Close Panel Button -->
                    <Button Grid.Column="4"
                            Content="✕"
                            Command="{Binding BackToKeyboardCommand}"
                            Click="OnNonSearchActionClick"
                            Background="Transparent"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8,4"
                            Margin="4,0,0,0"
                            FontSize="13"
                            Cursor="Hand"
                            ToolTip="Close Clipboard Panel" />
                </Grid>
            </Border>

            <!-- Row 1: Scrollable List of Pinned & Recent Clips -->
            <ScrollViewer Grid.Row="1"
                          Margin="6,4,6,2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Key.Regular.Background}"
                                    BorderBrush="{DynamicResource Brush.Window.Border}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="0,0,0,4"
                                    Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Click to Paste/Insert directly into active target window -->
                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.InsertEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Click="OnNonSearchActionClick"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Cursor="Hand"
                                            Focusable="False"
                                            ToolTip="Click to insert into active window">
                                        <TextBlock Text="{Binding PreviewText}"
                                                   FontFamily="{StaticResource FontFamily.Bengali}"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Pin / Unpin Button (📌) -->
                                    <Button Grid.Column="1"
                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Click="OnNonSearchActionClick"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="6,2"
                                            Margin="4,0,0,0"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Focusable="False"
                                            ToolTip="Pin or Unpin this clip">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="Pin" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Content" Value="📌 Pinned" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Delete Individual Clip Button -->
                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Click="OnNonSearchActionClick"
                                            Background="Transparent"
                                            Foreground="{DynamicResource Brush.Text.Secondary}"
                                            BorderThickness="0"
                                            Padding="6,2"
                                            Margin="2,0,0,0"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Focusable="False"
                                            ToolTip="Delete this clip" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Row 2: Privacy & Status Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="8,2">
                <DockPanel>
                    <TextBlock Text="🔒 100% Local DPAPI Encrypted • Passwords Excluded"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
