<Window x:Class="BengaliKeyboard.UI.Windows.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BornoKey Floating Icon"
        Width="72"
        Height="40"
        MinWidth="60"
        MinHeight="36"
        MaxWidth="96"
        MaxHeight="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Cursor="Hand"
        ToolTip="Left-click to expand keyboard • Drag to move • Right-click to toggle বাংলা/ENG">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="BadgeBorder"
            Background="{DynamicResource Brush.Header.Background}"
            BorderBrush="{DynamicResource Brush.Accent.Primary}"
            BorderThickness="1.5"
            CornerRadius="20"
            Padding="10,4"
            MouseLeftButtonDown="OnBadgeMouseLeftButtonDown"
            MouseMove="OnBadgeMouseMove"
            MouseLeftButtonUp="OnBadgeMouseLeftButtonUp"
            MouseRightButtonUp="OnBadgeMouseRightButtonUp">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot"
                     Width="7"
                     Height="7"
                     Fill="{DynamicResource Brush.Status.Success}"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0" />
            <TextBlock x:Name="BadgeLabelText"
                       Text="বাংলা"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontFamily="{StaticResource FontFamily.Bengali}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Padding="0,1,0,1" />
        </StackPanel>
    </Border>
</Window>
