<Window x:Class="BengaliKeyboard.UI.Windows.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BornoKey — Bengali Virtual Keyboard"
        Width="850"
        Height="310"
        MinWidth="520"
        MinHeight="210"
        MaxWidth="1600"
        MaxHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Colors.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Window.Background}"
            BorderBrush="{DynamicResource Brush.Window.Border}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Draggable Header Toolbar (32px) -->
                <RowDefinition Height="32" />
                <!-- Row 1: Suggestion Bar Area (38px) -->
                <RowDefinition Height="38" />
                <!-- Row 2: Main Keyboard Layout Container -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Title -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="≡"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontSize="15"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="BornoKey"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Brush.Accent.Primary}"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageBadgeText"
                                       Text="বাংলা"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontFamily="Noto Sans Bengali, Nirmala UI, Segoe UI"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Window Action Controls -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Width="28"
                                Height="22"
                                Margin="2,0"
                                Background="{DynamicResource Brush.Key.Special.Background}"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                BorderThickness="0"
                                ToolTip="Hide Keyboard"
                                Click="OnMinimizeClick" />
                        <Button x:Name="CloseButton"
                                Content="✕"
                                Width="28"
                                Height="22"
                                Margin="2,0,0,0"
                                Background="{DynamicResource Brush.Key.Special.Background}"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                BorderThickness="0"
                                ToolTip="Exit BornoKey"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Suggestion Bar Shell -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4">
                <UniformGrid Columns="4" VerticalAlignment="Center">
                    <TextBlock Text="আমার"
                               Foreground="{DynamicResource Brush.Accent.Primary}"
                               FontFamily="Noto Sans Bengali, Nirmala UI, Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Text="আমাকে"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="Noto Sans Bengali, Nirmala UI, Segoe UI"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Text="আমাদের"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontFamily="Noto Sans Bengali, Nirmala UI, Segoe UI"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Text="আমায়"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontFamily="Noto Sans Bengali, Nirmala UI, Segoe UI"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </UniformGrid>
            </Border>

            <!-- Row 2: Keyboard Grid Host (Populated dynamically by LayoutManager in Phase 2) -->
            <Grid x:Name="KeyboardGridHost"
                  Grid.Row="2"
                  Margin="6">
                <Border Background="{DynamicResource Brush.Key.Regular.Background}"
                        CornerRadius="6"
                        Padding="12">
                    <TextBlock Text="BornoKey Foundation Ready — Ridmik Bengali &amp; English Layout Host"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontFamily="Noto Sans Bengali, Nirmala UI, Segoe UI"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
