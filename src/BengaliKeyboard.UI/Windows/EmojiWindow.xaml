<Window x:Class="BengaliKeyboard.UI.Windows.EmojiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BornoKey — Emoji Keyboard"
        Width="850"
        Height="310"
        MinWidth="440"
        MinHeight="180"
        MaxWidth="1600"
        MaxHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/KeyStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Window.Background}"
            BorderBrush="{DynamicResource Brush.Window.Border}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header Bar with Search Box, Clear History, and Back to Keyboard -->
                <RowDefinition Height="38" />
                <!-- Row 1: 10 Category Strip -->
                <RowDefinition Height="34" />
                <!-- Row 2: Scrollable Emoji Grid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header & Instant Keyword Search -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back to Keyboard Button -->
                    <Button Grid.Column="0"
                            Content="← বাংলা / ABC"
                            Command="{Binding BackToKeyboardCommand}"
                            Click="OnNonSearchActionClick"
                            Background="{DynamicResource Brush.Key.Special.Background}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            BorderThickness="0"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            ToolTip="Return to Virtual Keyboard" />

                    <!-- Instant Offline Keyword Search Box -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource Brush.Key.Regular.Background}"
                            BorderBrush="{DynamicResource Brush.Window.Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2">
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     CaretBrush="{DynamicResource Brush.Accent.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.5"
                                     PreviewMouseLeftButtonDown="OnSearchBoxPreviewMouseLeftButtonDown"
                                     LostFocus="OnSearchBoxLostFocus" />
                            <TextBlock Text="Search emojis (smile, heart, food, fire, হাসি)..."
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Clear Frequently Used History Button -->
                    <Button Grid.Column="2"
                            Content="Clear History"
                            Command="{Binding ClearHistoryCommand}"
                            Click="OnNonSearchActionClick"
                            Background="{DynamicResource Brush.Key.Special.Background}"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8,4"
                            Margin="8,0,0,0"
                            FontSize="11.5"
                            Cursor="Hand"
                            ToolTip="Clear Frequently Used Emoji History" />

                    <!-- Close Panel Button -->
                    <Button Grid.Column="3"
                            Content="✕"
                            Command="{Binding BackToKeyboardCommand}"
                            Click="OnNonSearchActionClick"
                            Background="Transparent"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            BorderThickness="0"
                            Padding="8,4"
                            Margin="4,0,0,0"
                            FontSize="13"
                            Cursor="Hand"
                            ToolTip="Close Emoji Panel" />
                </Grid>
            </Border>

            <!-- Row 1: 10 Standard Emoji Categories Strip -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Window.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="6,3">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Click="OnNonSearchActionClick"
                                        Background="{DynamicResource Brush.Key.Regular.Background}"
                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                        BorderBrush="{DynamicResource Brush.Window.Border}"
                                        BorderThickness="1"
                                        Padding="8,3"
                                        Margin="0,0,4,0"
                                        FontSize="11.5"
                                        Cursor="Hand" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Row 2: Emoji Grid & Empty State Message -->
            <Grid Grid.Row="2" Margin="6,4,6,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DisplayedEmojis}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Click="OnNonSearchActionClick"
                                        Width="48"
                                        Height="44"
                                        Margin="2"
                                        Background="{DynamicResource Brush.Key.Regular.Background}"
                                        BorderBrush="{DynamicResource Brush.Window.Border}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Focusable="False"
                                        ToolTip="{Binding Name}">
                                    <TextBlock Text="{Binding Emoji}"
                                               FontFamily="{StaticResource FontFamily.Emoji}"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,8,4"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
