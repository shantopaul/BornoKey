<Window x:Class="BengaliKeyboard.UI.Windows.EmojiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BornoKey — Emoji Keyboard"
        Width="850"
        Height="310"
        MinWidth="440"
        MinHeight="180"
        MaxWidth="1600"
        MaxHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/Typography.xaml" />
                <ResourceDictionary Source="pack://application:,,,/BengaliKeyboard.UI;component/Themes/KeyStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Window.Background}"
            BorderBrush="{DynamicResource Brush.Window.Border}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header Bar with Back to Keyboard, Search Box, Clear Recent, and Close -->
                <RowDefinition Height="40" />
                <!-- Row 1: 10-Column Category Tab Bar (Zero Horizontal ScrollBar) -->
                <RowDefinition Height="36" />
                <!-- Row 2: Scrollable Emoji Grid & Popular Fallback Section -->
                <RowDefinition Height="*" />
                <!-- Row 3: Live Emoji Hover Preview & Status Footer Bar -->
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header & Instant Keyword Search -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back to Keyboard Button -->
                    <Button Grid.Column="0"
                            Content="← বাংলা / ABC"
                            Command="{Binding BackToKeyboardCommand}"
                            Click="OnNonSearchActionClick"
                            Style="{StaticResource Style.Button.ToolbarPill}"
                            Margin="0,0,8,0"
                            FontSize="12"
                            ToolTip="Return to Virtual Keyboard" />

                    <!-- Instant Offline Keyword Search Box -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource Brush.Key.Regular.Background}"
                            BorderBrush="{DynamicResource Brush.Window.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontFamily="{StaticResource FontFamily.Emoji}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       IsHitTestVisible="False" />

                            <TextBox Grid.Column="1"
                                     x:Name="SearchTextBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     CaretBrush="{DynamicResource Brush.Accent.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.5"
                                     PreviewMouseLeftButtonDown="OnSearchBoxPreviewMouseLeftButtonDown"
                                     LostFocus="OnSearchBoxLostFocus" />

                            <TextBlock Grid.Column="1"
                                       Text="Search emojis in English or বাংলা (smile, heart, fire, হাসি, ভালোবাসা)..."
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="2"
                                    Content="✕"
                                    Command="{Binding ClearSearchCommand}"
                                    Click="OnNonSearchActionClick"
                                    Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource Style.Button.SubtleAction}"
                                    Padding="5,1"
                                    FontSize="11"
                                    ToolTip="Clear Search" />
                        </Grid>
                    </Border>

                    <!-- Clear Frequently Used History Button -->
                    <Button Grid.Column="2"
                            Content="🗑️ Clear Recent"
                            Command="{Binding ClearHistoryCommand}"
                            Click="OnNonSearchActionClick"
                            Style="{StaticResource Style.Button.ToolbarPill}"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Margin="8,0,0,0"
                            ToolTip="Clear Frequently Used Emoji History" />

                    <!-- Close Panel Button -->
                    <Button Grid.Column="3"
                            Content="✕"
                            Command="{Binding BackToKeyboardCommand}"
                            Click="OnNonSearchActionClick"
                            Style="{StaticResource Style.Button.IconClose}"
                            Margin="6,0,0,0"
                            ToolTip="Close Emoji Panel" />
                </Grid>
            </Border>

            <!-- Row 1: 10-Column Uniform Category Tab Strip (Zero Scrollbar) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="6,2">
                <ItemsControl ItemsSource="{Binding CategoryTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding CategoryName}"
                                    Click="OnNonSearchActionClick"
                                    Style="{StaticResource Style.Button.EmojiCategoryTab}"
                                    ToolTip="{Binding DisplayTooltip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="{StaticResource FontFamily.Emoji}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ShortTitle}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Row 2: Scrollable Emoji Grid & Popular Fallback Section -->
            <Grid Grid.Row="2" Margin="8,4,6,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Active Category / Search Section Header -->
                        <TextBlock Text="{Binding CurrentSectionTitle}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Margin="4,2,0,4" />

                        <!-- Primary Emoji Grid -->
                        <ItemsControl ItemsSource="{Binding DisplayedEmojis}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Click="OnNonSearchActionClick"
                                            MouseEnter="OnEmojiTileMouseEnter"
                                            Style="{StaticResource Style.Button.EmojiTile}"
                                            ToolTip="{Binding Name}">
                                        <TextBlock Text="{Binding Emoji}"
                                                   FontFamily="{StaticResource FontFamily.Emoji}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Popular & Trending Quick Emojis (Shown when Recent has < 16 items) -->
                        <StackPanel Visibility="{Binding ShowPopularFallbackSection, Converter={StaticResource BoolToVis}}"
                                    Margin="0,8,0,2">
                            <Border BorderBrush="{DynamicResource Brush.Window.Border}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,6,0,0">
                                <TextBlock Text="✨  Popular &amp; Quick Emojis"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Margin="4,0,0,4" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding PopularEmojis}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Click="OnNonSearchActionClick"
                                                MouseEnter="OnEmojiTileMouseEnter"
                                                Style="{StaticResource Style.Button.EmojiTile}"
                                                ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding Emoji}"
                                                       FontFamily="{StaticResource FontFamily.Emoji}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Empty Search State Card -->
                        <Border Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource Brush.Header.Background}"
                                BorderBrush="{DynamicResource Brush.Window.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,16"
                                Margin="4,12,8,4"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔎"
                                           FontFamily="{StaticResource FontFamily.Emoji}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontSize="26"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <Button Content="Browse Smileys &amp; Emotions"
                                        Command="{Binding SelectCategoryCommand}"
                                        CommandParameter="Smileys &amp; Emotions"
                                        Click="OnNonSearchActionClick"
                                        Style="{StaticResource Style.Button.ToolbarPill}"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Row 3: Bottom Live Emoji Preview & Status Footer Bar -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Brush.Header.Background}"
                    BorderBrush="{DynamicResource Brush.Window.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="10,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="11.5"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PreviewEmoji}"
                                   FontFamily="{StaticResource FontFamily.Emoji}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding PreviewTitle}"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  •  "
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PreviewKeywords}"
                                   FontFamily="{StaticResource FontFamily.Bengali}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
